from bisos import b
# from bisos.b import cmndsSeed
from bisos.b import cs
from bisos.b import b_io

# import collections
import typing

import os

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
ap = pkgsSeed.aptPkg


def dockerAddRepo():
    """Post-install step: add Docker's official apt repository (idempotent).

    Adds Docker's GPG key and the stable apt source for the running Debian
    release, then runs apt-get update. A no-op if the keyring file and source
    list entry already exist.

    Reference: https://linuxiac.com/how-to-install-docker-on-debian-12-bookworm/
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        """
sudo apt-get update -qq
sudo apt-get install -y ca-certificates curl

sudo install -m 0755 -d /etc/apt/keyrings

if [ ! -f /etc/apt/keyrings/docker.asc ]; then
  sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  echo "wrote /etc/apt/keyrings/docker.asc"
else
  echo "/etc/apt/keyrings/docker.asc exists --- left as is"
fi

if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
  echo \\
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian \\
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \\
    sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
  echo "wrote /etc/apt/sources.list.d/docker.list"
else
  echo "/etc/apt/sources.list.d/docker.list exists --- left as is"
fi

sudo apt-get update -qq
""")


aptPkgsList = [
    # Step 1: add Docker's apt repository (func= pseudo-entry, no package yet).
    ap("dockerAddRepo", func=dockerAddRepo),  # adds GPG key + source list

    # Step 2: Docker engine and tools from Docker's official repo.
    ap("docker-ce"),
    ap("docker-ce-cli"),
    ap("containerd.io"),
    ap("docker-buildx-plugin"),
    ap("docker-compose-plugin"),

    # Multi-arch image builds (build.bash without -d, linux/amd64,arm64).
    ap("qemu-user-static"),   # cross-arch emulation
    ap("binfmt-support"),     # binfmt registration for qemu-user-static
]


pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = """\
** Scope: BISOS Docker host provisioning (for bro_dockerfiles docker images)

** Components installed (apt, from Docker's official repo):
  docker-ce, docker-ce-cli, containerd.io,
  docker-buildx-plugin, docker-compose-plugin,
  qemu-user-static, binfmt-support

** Pre-install step (func= pseudo-entry):
  dockerAddRepo  -- adds Docker's official GPG key and stable apt source for
                    the running Debian release (idempotent; skips if already present).
                    Reference: https://linuxiac.com/how-to-install-docker-on-debian-12-bookworm/

** Installation:
  dockerProc-sbom.pcs -i sbom_fullUpdate

** For rootless Podman (rootless-sysd profile), use podman-sbom.pcs instead.\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*dockerProc Docker Host Provisioning Examples*')
    if not (resStr := b.subProc.Op(outcome=cmndOutcome, log=0).bash(
       f"""which docker""").stdout):
        pass

    literal(f"which docker # {resStr.strip()}")
    literal("docker --version")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Install / Update*')
    literal("dockerProc-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*End-Of dockerProc Docker Host Provisioning Examples*')
    return cmndOutcome
